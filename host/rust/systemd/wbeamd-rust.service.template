[Unit]
Description=WBeam Rust Host Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
# Android is optional at daemon startup. ADB reverse failure before USB attach
# must not prevent the user service from starting its localhost control API.
# systemd's "-" prefix ignores a failing pre-start command (not a daemon failure).
ExecStartPre=-%h/.local/bin/wbeam-usb-reverse.sh 5000 5001
ExecStart=%h/.local/bin/wbeamd-rust --control-port 5001 --stream-port 5000 --root @ROOT@
Restart=always
RestartSec=1
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
