# Copy to e2e/env.local, adjust the ISO paths, then:
#   set -a
#   source e2e/env.local
#   set +a

WBEAM_E2E_ISO_FEDORA_43=/absolute/path/to/Fedora-Everything-netinst-x86_64-43-1.6.iso
WBEAM_E2E_ISO_UBUNTU_24_04=/absolute/path/to/ubuntu-24.04-desktop-amd64.iso
WBEAM_E2E_ISO_DEBIAN_12=/absolute/path/to/debian-12-amd64-netinst.iso

# Optional overrides.
# WBEAM_E2E_BASE_DIR=/fast/vm-images/wbeam-base
# WBEAM_E2E_WORK_DIR=/fast/tmp/wbeam-e2e-work
# WBEAM_E2E_REPORT_DIR=/fast/tmp/wbeam-e2e-reports
