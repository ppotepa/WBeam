{
  "schema": 1,
  "defaults": {
    "hypervisor": "qemu-kvm",
    "arch": "x86_64",
    "cpu": 4,
    "memory_mib": 8192,
    "disk_gib": 48,
    "control_port": 5001,
    "stream_port": 5000,
    "stream_duration_sec": 60,
    "encoder": "h264",
    "size": "1280x800",
    "fps": 30,
    "bitrate_kbps": 10000
  },
  "distros": [
    {
      "id": "fedora-43",
      "family": "fedora",
      "iso_env": "WBEAM_E2E_ISO_FEDORA_43",
      "installer": "kickstart",
      "desktop": "gnome",
      "ssh_user": "wbeam",
      "seed_kind": "fedora-kickstart",
      "install_timeout_sec": 5400,
      "boot_timeout_sec": 900,
      "shutdown_timeout_sec": 180
    },
    {
      "id": "ubuntu-24.04",
      "family": "ubuntu",
      "iso_env": "WBEAM_E2E_ISO_UBUNTU_24_04",
      "installer": "autoinstall",
      "desktop": "gnome",
      "ssh_user": "wbeam",
      "seed_kind": "ubuntu-nocloud",
      "install_timeout_sec": 5400,
      "boot_timeout_sec": 900,
      "shutdown_timeout_sec": 180
    },
    {
      "id": "debian-12",
      "family": "debian",
      "iso_env": "WBEAM_E2E_ISO_DEBIAN_12",
      "installer": "preseed",
      "desktop": "gnome",
      "ssh_user": "wbeam",
      "seed_kind": "debian-preseed",
      "install_timeout_sec": 5400,
      "boot_timeout_sec": 900,
      "shutdown_timeout_sec": 180
    }
  ],
  "scenarios": [
    {
      "id": "fedora43-headless-benchmark-h264",
      "distro": "fedora-43",
      "session": "headless",
      "backend": "benchmark_game",
      "display_mode": "benchmark_game",
      "tier": "smoke",
      "device_policy": "none",
      "expected_steps": [
        "host_preflight",
        "system_deps",
        "host_build",
        "service_setup",
        "stream_smoke"
      ],
      "wizard_flags": ["--yes", "--skip-device", "--stream-smoke"],
      "required_artifacts": ["guest/wizard/summary.json", "guest/wizard/steps.jsonl", "guest/wizard/stream/benchmark_game/summary.json"],
      "stability": "stable",
      "requires_desktop": false,
      "requires_evdi": false,
      "requires_portal": false,
      "tags": ["fedora", "smoke", "benchmark"]
    },
    {
      "id": "fedora43-gnome-wayland-portal-h264",
      "distro": "fedora-43",
      "session": "gnome-wayland",
      "backend": "wayland_portal",
      "display_mode": "virtual_monitor",
      "tier": "backend",
      "device_policy": "none",
      "expected_steps": [
        "host_preflight",
        "system_deps",
        "host_build",
        "service_setup",
