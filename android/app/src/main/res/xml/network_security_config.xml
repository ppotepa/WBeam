<?xml version="1.0" encoding="utf-8"?>
<!--
  The normal USB workflow uses cleartext HTTP through ADB reverse (port 5001).
  Configurable host addresses also permit deliberate LAN operation.
  This base-config allows cleartext globally; it does not restrict hosts to
  private IP ranges. Access restrictions belong to the transport deployment.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
